{
  "expo": {
    "name": "Hushållet",
    "slug": "Household",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "household",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF8A4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF8A4C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Hushållet använder mikrofonen för att spela in ljud till sysslor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hushållet behöver dina bilder för att lägga till en bild till en syssla.",
          "cameraPermission": "Hushållet använder kameran för att ta en bild till en syssla.",
          "microphonePermission": "Hushållet använder mikrofonen för att spela in ljud till sysslor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
